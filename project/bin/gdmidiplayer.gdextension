[configuration]

entry_symbol = "gdmidiplayer_library_init"
compatibility_minimum = "4.1"

[libraries]

linux.debug.x86_64 = "./linux/libgdmidiplayer.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./linux/libgdmidiplayer.linux.template_release.x86_64.so"
linux.debug.arm64 = "./linux/libgdmidiplayer.linux.template_debug.arm64.so"
linux.release.arm64 = "./linux/libgdmidiplayer.linux.template_release.arm64.so"
windows.debug.x86_64 = "./windows/libgdmidiplayer.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./windows/libgdmidiplayer.windows.template_release.x86_64.dll"
macos.debug = "./macos/libgdmidiplayer.macos.template_debug.framework"
macos.release = "./macos/libgdmidiplayer.macos.template_release.framework"
